# Development only. Copy to .env and choose a local password; never commit .env.
POSTGRES_DB=exportdocs
POSTGRES_USER=exportdocs
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
SERVER_PORT=8080
# Optional managed PostgreSQL overrides (one database, not a second primary):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.invalid:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=exportdocs
# SPRING_DATASOURCE_PASSWORD=provide-outside-git
